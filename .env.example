# GitHub Personal Access Token (Optional but recommended)
# Increases rate limits from 60 to 5000 requests per hour
# Create one at: https://github.com/settings/tokens
# No special permissions needed for public repos
GITHUB_TOKEN=your_github_token_here

# Google Gemini API Key (REQUIRED for AI-powered roasts)
# Get your free API key at: https://aistudio.google.com/app/apikey
# The application will fall back to template-based roasts if not provided
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configuration (Optional - defaults shown below)
# Customize model and parameters without code changes
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.9
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_MAX_OUTPUT_TOKENS=8192

# Website URL for social sharing (set in production)
# Used in Twitter/LinkedIn/Clipboard sharing messages
# Defaults to relative path in development
VITE_WEBSITE_URL=https://your-gitroast-domain.vercel.app
