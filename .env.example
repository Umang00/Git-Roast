# GitHub Personal Access Token (Optional but recommended)
# Increases rate limits from 60 to 5000 requests per hour
# Create one at: https://github.com/settings/tokens
# No special permissions needed for public repos
GITHUB_TOKEN=your_github_token_here

# Google Gemini API Key (REQUIRED for AI-powered roasts)
# Get your free API key at: https://makersuite.google.com/app/apikey
# or https://aistudio.google.com/app/apikey
# The application will fall back to template-based roasts if not provided
GEMINI_API_KEY=your_gemini_api_key_here
