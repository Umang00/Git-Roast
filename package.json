{
  "name": "gitroast",
  "version": "1.0.0",
  "description": "AI-powered Git history roaster - Get brutally honest feedback about your coding habits! 🔥",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "dev:legacy": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "vercel dev"
  },
  "keywords": ["git", "roast", "ai", "developer", "humor", "viral"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vercel": "^33.0.1"
  }
}
