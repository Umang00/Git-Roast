{
  "name": "gitroast",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered Git history roaster - Get brutally honest feedback about your coding habits! 🔥",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "lint": "cd frontend && npm run lint",
    "build": "cd frontend && npm run build",
    "start": "vercel dev"
  },
  "keywords": [
    "git",
    "roast",
    "ai",
    "developer",
    "humor",
    "viral"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@octokit/rest": "^20.0.2",
    "bottleneck": "^2.19.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.6",
    "vercel": "^48.12.0"
  }
}
