{
  "name": "gitroast",
  "version": "1.0.0",
  "description": "AI-powered Git history roaster - Get brutally honest feedback about your coding habits! 🔥",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:vercel": "vercel dev",
    "dev:api": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "lint": "cd frontend && npm run lint",
    "build": "cd frontend && npm run build",
    "start": "vercel dev"
  },
  "keywords": [
    "git",
    "roast",
    "ai",
    "developer",
    "humor",
    "viral"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^20.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vercel": "^33.0.1"
  }
}
